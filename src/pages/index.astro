---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects.ts';

const visible = projects.slice(0, 6);
const latestPosts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
const liveCount = visible.filter((project) => project.status === 'live').length;

const snapshot = [
  { label: 'experience', value: '8+ years', tone: 'live' },
  { label: 'archive', value: '56 repos', tone: 'idle' },
  { label: 'systems', value: 'Pi active', tone: 'live' },
];

const orbitNodes = [
  { label: 'automation', className: 'node-qa' },
  { label: 'pi', className: 'node-pi' },
  { label: 'agents', className: 'node-agents' },
  { label: 'systems', className: 'node-rpg' },
  { label: 'archive', className: 'node-archive' },
];
---

<Base>
  <Header current="home" />

  <section class="hero">
    <div class="container-wide hero-grid">
      <div class="hero-copy">
        <p class="hero-eyebrow mono">
          <span class="hero-star">★</span>
          M.S. Bel / QA Engineer / Istanbul
        </p>
        <h1 class="hero-title">QA Engineer building reliable automation.</h1>
        <p class="visually-hidden">
          M.S. Bel is a QA Engineer and automation builder in Istanbul.
          The portfolio spans test automation, agent workflows, Pi-hosted
          tooling, trading experiments, and hand-built RPG systems.
        </p>
        <p class="hero-sub">
          Eight years of software and test automation work across fintech,
          telecom, AI agents, Pi-hosted tooling, trading systems, and
          simulation-heavy side projects.
        </p>
        <div class="hero-actions">
          <a class="hero-link primary" href="/projects">see the archive</a>
          <a class="hero-link" href="/writing">read field notes</a>
        </div>
        <div class="hero-meta mono">
          <span><span class="status-dot live"></span>Pi reachable</span>
          <span class="dim">/</span>
          <span>{liveCount} live projects</span>
          <span class="dim">/</span>
          <span>last deploy {new Date().toISOString().split('T')[0]}</span>
        </div>
      </div>

      <aside class="observatory" aria-label="Current work map">
        <svg class="observatory-lines" viewBox="0 0 520 420" aria-hidden="true">
          <path d="M92 284L205 129L330 212L436 86" />
          <path d="M205 129L250 328L330 212" />
          <path d="M92 284L250 328L436 86" />
          <path d="M205 129L436 86" />
        </svg>
        {orbitNodes.map((node) => (
          <div class={`orbit-node ${node.className}`}>
            <span class="node-dot"></span>
            <span class="node-label mono">{node.label}</span>
          </div>
        ))}
        <div class="observatory-core">
          <span class="core-mark">★</span>
          <span class="core-text mono">M.S. Bel</span>
        </div>
      </aside>
    </div>
  </section>

  <section class="signal">
    <div class="container-wide signal-grid">
      <div>
        <p class="section-eyebrow">current signal</p>
        <p class="now-text">
          This portfolio is built as an engineering record: shipped code,
          tested systems, live Pi services, and the long-running archive
          behind them. The tone is professional first, personal where the
          work explains the person.
        </p>
      </div>
      <dl class="snapshot">
        {snapshot.map((item) => (
          <div class="snapshot-item">
            <dt class="mono">
              <span class={`snapshot-dot ${item.tone}`}></span>
              {item.label}
            </dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="projects">
    <div class="container">
      <p class="section-eyebrow">selected work</p>
      <h2 class="projects-heading">Six recent builds.</h2>

      <div class="projects-list">
        {visible.map((project) => (
          <ProjectCard
            number={project.number}
            title={project.title}
            year={project.year}
            status={project.status}
            description={project.description}
            tags={project.tags}
            liveUrl={project.liveUrl}
            notesUrl={project.notesUrl}
            repoUrl={project.repoUrl}
          />
        ))}
      </div>

      <div class="projects-footer">
        <a href="/projects" class="subtle">see all projects</a>
      </div>
    </div>
  </section>

  <section class="writing-preview">
    <div class="container">
      <p class="section-eyebrow">field notes</p>
      <h2 class="writing-heading">The build log stays public.</h2>
      <div class="writing-list">
        {latestPosts.map((post) => (
          <a class="writing-item" href={`/writing/${post.slug}`}>
            <time class="mono">{post.data.pubDate.toISOString().split('T')[0]}</time>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="connect">
    <div class="container">
      <p class="section-eyebrow">contact</p>
      <h2 class="connect-heading">Useful work, clean tests, reliable systems.</h2>
      <p class="connect-text">
        Available for QA automation work, agent-system collaboration, and
        technical conversations about software that has to survive real
        production constraints.
      </p>
      <div class="connect-links mono">
        <a href="mailto:msbel5@gmail.com">msbel5@gmail.com</a>
        <a href="https://github.com/msbel5" target="_blank" rel="noopener">github / msbel5</a>
        <a href="https://www.linkedin.com/in/msbel5" target="_blank" rel="noopener">linkedin / msbel5</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    min-height: min(820px, 100svh);
    display: flex;
    align-items: center;
    padding-top: 9rem;
    padding-bottom: 6rem;
    border-top: none !important;
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(180deg, rgba(13, 14, 16, 0.72), rgba(13, 14, 16, 1)),
      linear-gradient(120deg, rgba(91, 158, 255, 0.08), transparent 34%);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 4rem 0 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-bright), transparent);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.96fr) minmax(320px, 0.78fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: center;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--text-muted);
    font-size: 0.8125rem;
    letter-spacing: 0.05em;
    margin-bottom: 1.75rem;
    text-transform: lowercase;
  }

  .hero-star {
    color: var(--accent);
  }

  .hero-title {
    font-size: clamp(3.2rem, 8vw, 6.6rem);
    line-height: 0.92;
    max-width: 9.6ch;
    margin-bottom: 1.75rem;
  }

  .hero-sub {
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 48ch;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2.25rem;
  }

  .hero-link {
    min-height: 2.5rem;
    display: inline-flex;
    align-items: center;
    border-bottom: 1px solid var(--border-bright);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .hero-link:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateX(2px);
  }

  .hero-link.primary {
    color: var(--accent);
    border-color: var(--accent-muted);
  }

  .hero-meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
    color: var(--text-muted);
    font-size: 0.8125rem;
  }

  .hero-meta .dim {
    color: var(--text-faint);
  }

  .observatory {
    min-height: 420px;
    position: relative;
    border-left: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background:
      linear-gradient(90deg, rgba(91, 158, 255, 0.08) 1px, transparent 1px),
      linear-gradient(180deg, rgba(235, 229, 216, 0.035) 1px, transparent 1px);
    background-size: 64px 64px;
  }

  .observatory-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .observatory-lines path {
    fill: none;
    stroke: var(--border-bright);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .orbit-node {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .node-dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    border: 1px solid var(--accent);
    background: var(--bg-base);
    box-shadow: 0 0 0 4px rgba(91, 158, 255, 0.08);
  }

  .node-qa { left: 14%; top: 66%; }
  .node-pi { left: 36%; top: 27%; }
  .node-agents { left: 62%; top: 47%; }
  .node-rpg { right: 8%; top: 17%; }
  .node-archive { left: 46%; bottom: 17%; }

  .observatory-core {
    position: absolute;
    right: 7%;
    bottom: 9%;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-secondary);
  }

  .core-mark {
    color: var(--accent);
  }

  .core-text {
    letter-spacing: 0.08em;
  }

  .signal-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.42fr);
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: start;
  }

  .now-text {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.2vw, 1.65rem);
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 44ch;
  }

  .snapshot {
    border-top: 1px solid var(--border);
  }

  .snapshot-item {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }

  .snapshot dt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .snapshot dd {
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 1.25rem;
  }

  .snapshot-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    display: inline-block;
  }

  .snapshot-dot.live { background: var(--status-live); }
  .snapshot-dot.idle { background: var(--status-idle); }

  .projects-heading,
  .writing-heading,
  .connect-heading {
    margin-bottom: 3rem;
    max-width: 13ch;
  }

  .projects-list {
    margin-bottom: 3rem;
  }

  .projects-footer {
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  .projects-footer a {
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .writing-list {
    display: grid;
    gap: 1.5rem;
  }

  .writing-item {
    display: block;
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
    color: var(--text-primary);
  }

  .writing-item:last-child {
    border-bottom: 1px solid var(--border);
  }

  .writing-item time {
    display: block;
    color: var(--text-muted);
    font-size: 0.75rem;
    margin-bottom: 0.6rem;
  }

  .writing-item h3 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 400;
    margin-bottom: 0.5rem;
  }

  .writing-item p {
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 60ch;
  }

  .writing-item:hover h3 {
    color: var(--accent);
  }

  .connect-heading {
    max-width: 16ch;
  }

  .connect-text {
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 56ch;
    margin-bottom: 2.25rem;
  }

  .connect-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .connect-links a {
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-bright);
    padding-bottom: 0.125rem;
    width: max-content;
    font-size: 0.9375rem;
  }

  .connect-links a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  @media (max-width: 860px) {
    .hero {
      min-height: auto;
      padding-top: 8rem;
    }

    .hero-grid,
    .signal-grid {
      grid-template-columns: 1fr;
    }

    .observatory {
      min-height: 320px;
      order: -1;
    }
  }

  @media (max-width: 560px) {
    .hero {
      padding-bottom: 4rem;
    }

    .hero-title {
      font-size: clamp(3rem, 15vw, 4.2rem);
      max-width: 9ch;
    }

    .hero-actions {
      gap: 0.75rem;
    }

    .observatory {
      min-height: 260px;
      background-size: 48px 48px;
    }

    .node-label {
      font-size: 0.65rem;
    }

    .node-agents {
      left: 56%;
    }

    .snapshot-item {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
