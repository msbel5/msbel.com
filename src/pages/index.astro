---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects.ts';

const visible = projects.slice(0, 6);
---

<Base>
  <Header current="home" />

  <!-- Hero -->
  <section class="hero">
    <svg class="starfield" viewBox="0 0 1200 600" preserveAspectRatio="xMaxYMin slice" aria-hidden="true">
      <g fill="#7aa7ff">
        <circle cx="980" cy="60" r="1.6"/>
        <circle cx="1080" cy="120" r="1.2"/>
        <circle cx="1140" cy="40" r="2"/>
        <circle cx="900" cy="180" r="1.4"/>
        <circle cx="1040" cy="220" r="1.1"/>
        <circle cx="850" cy="100" r="0.9"/>
      </g>
      <g fill="#5cd6c4" opacity="0.65">
        <circle cx="1100" cy="280" r="1.4"/>
        <circle cx="950" cy="320" r="1.1"/>
        <circle cx="1180" cy="200" r="1.3"/>
      </g>
      <g fill="#2a2d33">
        <circle cx="820" cy="40" r="0.9"/>
        <circle cx="780" cy="120" r="0.8"/>
        <circle cx="1160" cy="340" r="0.7"/>
        <circle cx="880" cy="260" r="0.9"/>
      </g>
      <!-- Faint constellation lines -->
      <g stroke="#7aa7ff" stroke-width="0.5" opacity="0.35" fill="none">
        <line x1="980" y1="60" x2="1080" y2="120"/>
        <line x1="1080" y1="120" x2="1140" y2="40"/>
        <line x1="900" y1="180" x2="1040" y2="220"/>
        <line x1="1040" y1="220" x2="1100" y2="280"/>
      </g>
    </svg>
    <div class="container">
      <p class="hero-eyebrow mono">
        <span class="hero-star" aria-hidden="true">★</span>
        msbel · istanbul, tr
      </p>
      <h1 class="hero-title">
        Engineer building quiet, durable systems.
        A self-hosted AI, a trading bot, a QA agent, a hand-crafted RPG.
      </h1>
      <p class="visually-hidden">
        msbel — senior test automation engineer in Istanbul, Turkey.
        Mechanical engineer trained at Istanbul University; mechatronics
        master's at Marmara University. Builds Alcyone (a self-hosted
        multi-agent AI on a Raspberry Pi 5), Thalamus (an OpenClaw
        community plugin on ClawHub and npm), a 9-layer testnet trading
        bot on the same Pi, an AI QA agent, and a hand-crafted RPG in
        Unity. GitHub: msbel5.
      </p>
      <p class="hero-sub">
        Senior test automation engineer by day. Builder of a self-hosted
        AI called <a href="/projects/alcyone" class="subtle">Alcyone</a>
        on a Raspberry Pi 5 in Istanbul.
      </p>
    </div>
  </section>

  <!-- Now -->
  <section class="now">
    <div class="container">
      <p class="section-eyebrow">currently</p>
      <p class="now-text">
        Running the trading bot 24/7 on testnet. Nine signal layers,
        46 ML features, no fabrication. Drafting an AI QA agent that
        writes its own end-to-end tests by watching the page. Estonian
        e-Residency application is in flight. In the queue: rewriting
        <em>Ember</em> by hand in Unity, because AI-generated games
        cannot be played.
      </p>
    </div>
  </section>

  <!-- Projects -->
  <section class="projects">
    <div class="container">
      <p class="section-eyebrow">selected work</p>
      <h2 class="projects-heading">Six recent builds.</h2>

      <div class="projects-list">
        {visible.map((project) => (
          <ProjectCard
            number={project.number}
            title={project.title}
            year={project.year}
            status={project.status}
            description={project.description}
            tags={project.tags}
            liveUrl={project.liveUrl}
            notesUrl={project.notesUrl}
            repoUrl={project.repoUrl}
          />
        ))}
      </div>

      <div class="projects-footer">
        <a href="/projects" class="subtle">see all projects →</a>
      </div>
    </div>
  </section>

  <!-- Connect -->
  <section class="connect">
    <div class="container">
      <p class="section-eyebrow">connect</p>
      <h2 class="connect-heading"><em>Reach out.</em></h2>
      <p class="connect-text">
        Open to collaborating on AI agent systems, contracting for
        test automation infrastructure, or trading notes on what is
        actually working in production.
      </p>
      <div class="connect-links mono">
        <a href="mailto:msbel5@gmail.com">msbel5@gmail.com</a>
        <a href="https://github.com/msbel5" target="_blank" rel="noopener">github / msbel5</a>
        <a href="https://www.linkedin.com/in/msbel5" target="_blank" rel="noopener">linkedin / msbel5</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── Hero ─────────────────────────────────────────────── */

  .hero {
    padding-top: 12rem;
    padding-bottom: 6rem;
    border-top: none !important;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 20%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, var(--accent-glow), transparent 70%);
    pointer-events: none;
    z-index: -1;
    filter: blur(80px);
  }

  .starfield {
    position: absolute;
    top: 0;
    right: 0;
    width: 60%;
    height: 100%;
    max-height: 600px;
    pointer-events: none;
    z-index: 0;
    opacity: 0.85;
  }

  .starfield circle {
    animation: starTwinkle 6s ease-in-out infinite;
  }

  .starfield g:nth-child(2) circle { animation-delay: 1.2s; }
  .starfield g:nth-child(3) circle { animation-delay: 2.6s; }

  @keyframes starTwinkle {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
  }

  .hero .container { position: relative; z-index: 1; }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
    text-transform: lowercase;
    letter-spacing: 0.05em;
    margin-bottom: 2rem;
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  .hero-star {
    color: var(--accent);
    animation: twinkle 4s ease-in-out infinite;
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0.7; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.2); }
  }

  .hero-title {
    font-size: clamp(2.5rem, 6.5vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin-bottom: 2rem;
    max-width: 18ch;
  }

  .hero-title em {
    font-style: italic;
    color: var(--accent);
    font-variation-settings: 'opsz' 144, 'SOFT' 80;
  }

  .hero-sub {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 56ch;
    margin-bottom: 2.5rem;
  }

  .hero-meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .hero-meta .dim { color: var(--text-faint); }

  /* ── Now ─────────────────────────────────────────────── */

  .now-text {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    line-height: 1.55;
    color: var(--text-secondary);
    max-width: 40ch;
  }

  .now-text em {
    font-style: italic;
    color: var(--text-primary);
  }

  /* ── Projects ──────────────────────────────────────── */

  .projects-heading {
    margin-bottom: 3rem;
    font-style: italic;
    color: var(--text-primary);
  }

  .projects-list {
    margin-bottom: 3rem;
  }

  .projects-footer {
    text-align: center;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .projects-footer a {
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  /* ── Connect ───────────────────────────────────────── */

  .connect-heading {
    margin-bottom: 1.5rem;
  }

  .connect-heading em {
    font-style: italic;
    color: var(--accent);
  }

  .connect-text {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 56ch;
    margin-bottom: 2.5rem;
  }

  .connect-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .connect-links a {
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-bright);
    padding-bottom: 0.125rem;
    width: max-content;
    font-size: 0.9375rem;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .connect-links a:hover {
    border-bottom-color: var(--accent);
    color: var(--accent);
  }
</style>
