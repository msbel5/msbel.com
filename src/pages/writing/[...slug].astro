---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'writing'>;
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Base title={`${post.data.title} — msbel`} description={post.data.description}>
  <Header current="writing" />

  <article class="post">
    <div class="container">
      <a href="/writing" class="back-link mono">← all writing</a>

      {post.data.heroImage && (
        <figure class="post-hero-banner">
          <img src={post.data.heroImage} alt={post.data.title} loading="eager" fetchpriority="high" />
        </figure>
      )}

      <header class="post-header">
        <time class="post-date mono">
          {post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        <h1 class="post-title">{post.data.title}</h1>
        <p class="post-description">{post.data.description}</p>
        {post.data.tags.length > 0 && (
          <div class="post-tags mono">
            {post.data.tags.map((tag) => <span class="tag">#{tag}</span>)}
          </div>
        )}
      </header>

      <div class="post-content">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  .post {
    padding-top: 9rem;
    padding-bottom: 6rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-bottom: 3rem;
    border-bottom: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .back-link:hover { color: var(--accent); }

  .post-hero-banner {
    margin: 0 0 3rem;
    padding: 0;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-surface);
  }

  .post-hero-banner img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 360px;
    object-fit: cover;
  }

  .post-header {
    margin-bottom: 4rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .post-date {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 1rem;
    display: block;
  }

  .post-title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-style: italic;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .post-description {
    font-size: 1.125rem;
    color: var(--text-secondary);
    max-width: 56ch;
    margin-bottom: 1.5rem;
  }

  .post-tags {
    display: flex;
    gap: 0.75rem;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .post-tags .tag {
    color: var(--accent);
  }

  .post-content {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--text-secondary);
    max-width: 65ch;
  }

  .post-content :global(h2) {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 400;
    color: var(--text-primary);
    margin-top: 3rem;
    margin-bottom: 1rem;
  }

  .post-content :global(h3) {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 400;
    color: var(--text-primary);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .post-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .post-content :global(em) {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--text-primary);
  }

  .post-content :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .post-content :global(figure.post-figure) {
    margin: 2.5rem 0;
  }

  .post-content :global(figure.post-figure img) {
    width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: #1a1a2e;
    display: block;
  }

  .post-content :global(figure.post-figure figcaption) {
    margin-top: 0.875rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.55;
    font-style: italic;
    text-align: center;
    max-width: 56ch;
    margin-left: auto;
    margin-right: auto;
  }

  .post-content :global(a) {
    color: var(--accent);
    border-bottom: 1px solid var(--accent-muted);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .post-content :global(a:hover) {
    border-bottom-color: var(--accent);
  }

  .post-content :global(blockquote) {
    border-left: 2px solid var(--accent);
    padding-left: 1.5rem;
    margin: 2rem 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--text-primary);
  }

  .post-content :global(code) {
    background: var(--bg-surface);
    padding: 0.125em 0.375em;
    border-radius: 4px;
    border: 1px solid var(--border);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.875em;
  }

  .post-content :global(pre) {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }

  .post-content :global(pre code) {
    background: none;
    border: none;
    padding: 0;
  }

  .post-content :global(ul), .post-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }
</style>
