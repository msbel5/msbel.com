  ],
  'AI / ML': [
    'PyTorch', 'scikit-learn', 'LightGBM', 'XGBoost', 'CryptoBERT',
    'AutoGen (multi-agent, since 2024)', 'Claude API', 'OpenAI API',
  ],
  Backend: [
    'FastAPI', 'ASP.NET Core', 'Node.js', 'PostgreSQL', 'SQLite',
    'Redis', 'JWT / OAuth',
  ],
