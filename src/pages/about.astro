---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';

const experience = [
  {
    role: 'Senior Test Automation Specialist',
    company: 'Testinium',
    period: '2023 — present',
    notes: [
      'Authoring a Python end-to-end test framework from scratch — Gauge-style DSL, Postman-like API testing surface, parallel execution via pytest-xdist',
      'Designing test infrastructure for a Saudi Arabian fintech project — GitLab CI/CD, Appium for mobile, screenshot diff regression, contract testing',
      'Building Pegasus, an in-house AI test generation agent that authors production-ready Selenium/Gauge specs from snapshot-based discovery',
      'Mentoring mid-level QA engineers; running weekly automation-craft sessions',
    ],
  },
  {
    role: 'Test Automation Engineer',
    company: 'Huawei Technologies',
    period: '2018 — 2023',
    notes: [
      'Five years on telecom-grade systems — performance, integration, and regression at scale',
      'Built internal test tooling adopted across multiple teams',
      'Worked across Linux, embedded, and cloud surfaces — comfortable with whatever the stack demands',
      'Developed automation pipelines that ran nightly across hundreds of test devices',
    ],
  },
];

const education = [
  {
    degree: 'M.Sc. Mechatronics Engineering',
    school: 'Marmara University',
    period: '2018 — present (defense pending)',
    thesis: '"Predictive Maintenance for Electrical Motors by Using Machine Learning"',
    thesisDetail:
      'Coursework completed. Thesis written under Prof. Dr. Mustafa Caner Akıner. Defense still pending — the manuscript is on the desk; the date is not. ' +
      'Premise: take an existing paper on motor failure prediction, replicate it with new data and a wider model bench. ' +
      'Apparatus: an MPU6050 6-axis gyroscope mounted on a CPU fan, varied weights stuck to the blades to simulate vibration profiles, Arduino Mega 2560 for capture. ' +
      'Pipeline: R for initial signal analysis, Python for the ML stack — 35 model candidates, GridSearch-optimized, ANN baseline at RMSE 308 brought down to 9.70 time-windows (~7 seconds each) usable for real predictive maintenance once paired with PLC-grade sensors. ' +
      'Conference draft: "Estimating Failure Times for Electric Motors by Machine Learning." ' +
      'Thesis proposal first submitted Oct 2020, revised Aug 2023 with new references, defense still pending.',
  },
  {
    degree: 'B.Sc. Mechanical Engineering',
    school: 'Istanbul University',
    period: '2010 — 2016',
    thesis: '"Position Control of Linear Motors"',
    thesisDetail:
      'Supervisor: Yrd.Doç.Dr. Yener Taşkın. Hardware-in-the-loop control: LabVIEW driving a National Instruments PCI-6289 DAQ card, Arduino producing dual- and triple-channel PWM signals, and a stepper-style position-control loop wrapping the linear motor. The .vi files survived to this day — lineermotorpwmv4 (Arduino dual-signal), lineermotorpwmv5.2 (PCI-6289), stepper konum kontrolü.vi. NI Turkey\'s distributor (Enovas) visited the lab during the project. Six years of coursework around it — CAD/CAM, fluid dynamics, finite element analysis, the long slow craft of mechanical thinking. The skill that survived: load paths and tolerances, the same instinct now applied to software systems.',
  },
