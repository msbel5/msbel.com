---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';

const experience = [
  {
    role: 'Senior Test Automation Engineer',
    company: 'Test automation services firm',
    period: '2023 - present',
    notes: [
      'Building banking automation across FX trading, arbitrage, transfers, joint accounts, authorization flows, e-Branch, and back-office SSO.',
      'Maintaining Python automation infrastructure on pytest, Selenium, Appium, Allure, Slack notifications, OCR verification, async DB tests, and parallel execution.',
      'Shipping .NET 8 health-monitor tooling that converts OpenAPI documents into automated probes, assertions, and alert workflows.',
      'Building AI-assisted test generation that turns locator snapshots into Selenium and Gauge coverage.',
    ],
  },
  {
    role: 'Test Automation Engineer',
    company: 'Global telecom equipment company',
    period: '2018 - 2023',
    notes: [
      'Five years on telecom-grade systems - performance, integration, and regression at scale.',
      'Internal test tooling adopted across multiple teams.',
      'Comfortable with Linux, embedded, cloud - whatever the stack demanded.',
      'Automation pipelines running nightly across hundreds of test devices.',
    ],
  },
];

const education = [
  {
    degree: 'M.Sc. Mechatronics Engineering',
    school: 'Marmara University',
    period: '2018 - present',
    note:
      'Thesis: "Predictive Maintenance for Electrical Motors by Using Machine Learning." Coursework done, manuscript on the desk, defense pending. A second master\'s project - image-processing-based defect detection - reached 98.3% test accuracy on a 40,000-image cement-surface dataset using VGG16 transfer learning.',
  },
  {
    degree: 'B.Sc. Mechanical Engineering',
    school: 'Istanbul University',
    period: '2010 - 2016',
    note:
      'Thesis on the position control of linear motors - LabVIEW driving an NI PCI-6289 DAQ, Arduino producing the PWM signals. Six years of CAD, control theory, and the slow physics-first habit of mind that has stayed with me since.',
  },
];

const stack = {
  Languages: ['Python', 'Java', 'C#', 'TypeScript', 'C++'],
  'Test automation': ['Selenium', 'Appium', 'Gauge', 'pytest', 'Playwright'],
  'AI / ML': [
    'LangGraph', 'CrewAI', 'Agno', 'AutoGen', 'PyTorch',
    'scikit-learn', 'LightGBM', 'XGBoost', 'Claude API', 'OpenAI API',
  ],
  Backend: ['FastAPI', 'ASP.NET Core', 'Node.js', 'PostgreSQL', 'Redis'],
  Infrastructure: [
    'Docker', 'systemd', 'Cloudflare Tunnel', 'Cloudflare Pages',
    'Raspberry Pi 5', 'Linux daily-driven',
  ],
  Hardware: ['Arduino', 'LabVIEW', 'NI PCI-6289', 'GPIO / serial'],
  'Game / engine': ['Unity', 'Godot', 'GameMaker (childhood)'],
  'Taste archive': ['RPG systems', 'tactics', 'simulation', 'classic cinema'],
};
---

<Base
  title="About - M.S. Bel"
  description="M.S. Bel, QA Engineer in Istanbul. Mechanical by training, automation engineer by practice."
>
  <Header current="about" />

  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <p class="section-eyebrow">about</p>
      <h1 class="page-title">M.S. Bel.</h1>
      <p class="page-sub">
        QA Engineer in Istanbul. Mechanical by training, automation
        engineer by practice. The work spans banking and telecom test
        systems, AI agents, Pi-hosted tooling, and hand-built RPG systems.
      </p>
    </div>
  </section>

  <!-- Story -->
  <section class="bio-section">
    <div class="container">
      <p class="section-eyebrow">story</p>
      <div class="bio-text">
        <p>
          The engineering instinct started early: <em>Back to the Future</em>,
          an Atari clone, then a DOS machine with no Windows and a black
          screen where every command produced visible cause and effect.
          Mechanical systems came first, but software became the place
          where the frontier still felt open.
        </p>
        <p>
          The formal route went through Mechanical Engineering at Istanbul
          University and Mechatronics Engineering at Marmara University.
          The bachelor's thesis used LabVIEW, a National Instruments DAQ,
          Arduino PWM generation, and a control loop for linear motors.
          Later coursework moved through MEMS, ergonomics, control theory,
          and machine-learning projects, including VGG16 transfer learning
          on a 40,000-image defect-detection dataset with 98.3 percent test
          accuracy. The master's thesis is on motor predictive maintenance.
        </p>
        <p>
          The software record starts on GitHub in 2017. Five years on
          telecom-grade systems built the habit of testing at scale; the
          current banking and fintech automation work sharpened the habit
          of making tests readable, repeatable, and useful under production
          constraints. In January 2024, dAIlog brought seven AutoGen agents
          into one loop: planner, engineer, executor, critic, and supporting
          roles coordinating from a single prompt.
        </p>
        <p>
          The current bench includes
          <a href="/projects/alcyone" class="subtle">Alcyone</a>, a
          Pi-hosted trading system;
          <a href="/projects/thalamus" class="subtle">Thalamus</a>, an
          OpenClaw packet-handoff plugin;
          <a href="/projects/pegasus" class="subtle">Pegasus</a>, a QA
          automation agent; and
          <a href="/projects/ember" class="subtle">Ember</a>, a hand-built
          RPG in Unity. The thread is consistent from 2017 onward: ship the
          artifact, keep the evidence, write down the lesson.
        </p>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section class="experience-section">
    <div class="container">
      <p class="section-eyebrow">experience</p>
      <div class="experience-list">
        {experience.map((job) => (
          <div class="job">
            <div class="job-meta mono">
              <span class="job-period">{job.period}</span>
            </div>
            <div class="job-body">
              <h3 class="job-role">{job.role}</h3>
              <p class="job-company">{job.company}</p>
              <ul class="job-notes">
                {job.notes.map((note) => <li>{note}</li>)}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Education -->
  <section class="education-section">
    <div class="container">
      <p class="section-eyebrow">education</p>
      <div class="education-list">
        {education.map((edu) => (
          <div class="edu-item">
            <div class="edu-meta mono">
              <span>{edu.period}</span>
            </div>
            <div class="edu-body">
              <h3>{edu.degree}</h3>
              <p class="edu-school">{edu.school}</p>
              <p class="edu-thesis-detail">{edu.note}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stack -->
  <section class="stack-section">
    <div class="container">
      <p class="section-eyebrow">stack</p>
      <h2 class="stack-heading">Tools the fleet runs on.</h2>
      <div class="stack-grid">
        {Object.entries(stack).map(([category, items]) => (
          <div class="stack-group">
            <p class="stack-category mono">{category}</p>
            <ul class="stack-items">
              {items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Asides -->
  <section class="asides-section">
    <div class="container">
      <p class="section-eyebrow">also</p>
      <ul class="asides">
        <li>
          <span class="aside-mono mono">2010-2018</span>
          <span>Eight years of theatre - high-school and university stages. Same discipline as engineering, just different costumes.</span>
        </li>
        <li>
          <span class="aside-mono mono">17,180 h</span>
          <span>Lifetime gaming hours per the GOG Galaxy export. Most of the time sits in RPGs, tactics, shooters, simulation, and strategy: Fallout, UnderRail, Pathfinder, RimWorld, Baldur's Gate, Dyson Sphere Program, Witcher, Civilization.</span>
        </li>
        <li>
          <span class="aside-mono mono">324 films</span>
          <span>IMDb archive leans toward drama, thriller, science fiction, crime, war, and systems under pressure: Apocalypse Now, The Godfather, 12 Angry Men, Inception, Seven Samurai, Fight Club.</span>
        </li>
        <li>
          <span class="aside-mono mono">56 repos</span>
          <span><a href="https://github.com/msbel5" class="subtle" target="_blank" rel="noopener">github.com/msbel5</a> - chronological archive going back to 2017.</span>
        </li>
        <li>
          <span class="aside-mono mono">native</span>
          <span>Turkish (TR) - fluent English (EN).</span>
        </li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .page-hero {
    padding-top: 9rem;
    padding-bottom: 3.5rem;
    border-top: none !important;
  }

  .page-title {
    font-style: italic;
    margin-bottom: 1.25rem;
  }

  .page-sub {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 56ch;
  }

  .page-sub em {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--text-primary);
  }

  .bio-text p {
    font-size: 1.0625rem;
    line-height: 1.78;
    color: var(--text-secondary);
    max-width: 64ch;
    margin-bottom: 1.5rem;
  }

  .bio-text p:last-child { margin-bottom: 0; }

  .bio-text em {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--text-primary);
  }

  .experience-list, .education-list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .job, .edu-item {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .job:last-child, .edu-item:last-child { border-bottom: none; padding-bottom: 0; }

  @media (max-width: 640px) {
    .job, .edu-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }

  .job-meta, .edu-meta {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    padding-top: 0.375rem;
  }

  .job-role, .edu-item h3 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .job-company, .edu-school {
    font-size: 0.9375rem;
    color: var(--accent);
    margin-bottom: 0.875rem;
    font-family: var(--font-mono);
  }

  .edu-thesis-detail {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 60ch;
  }

  .job-notes {
    list-style: none;
    padding: 0;
  }

  .job-notes li {
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 0.5rem;
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .job-notes li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .stack-heading {
    margin-bottom: 2.5rem;
    font-style: italic;
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
  }

  .stack-category {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .stack-items {
    list-style: none;
    padding: 0;
  }

  .stack-items li {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    padding: 0.375rem 0;
    border-bottom: 1px solid var(--border);
  }

  .stack-items li:last-child { border-bottom: none; }

  .asides {
    list-style: none;
    padding: 0;
  }

  .asides li {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 1.5rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .asides li:last-child { border-bottom: none; }

  @media (max-width: 640px) {
    .asides li {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }

  .aside-mono {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    padding-top: 0.125rem;
  }

  .asides em, .asides a {
    color: var(--text-primary);
  }
</style>
