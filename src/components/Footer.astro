---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-meta">
        <div class="footer-line">
          <span class="dim">built on</span>
          <a href="/projects/alcyone" class="subtle">a Raspberry Pi 5 named Alcyone</a>
        </div>
        <div class="footer-line">
          <span class="dim">© {year}</span>
          <span>msbel · Istanbul, TR</span>
        </div>
      </div>

      <nav class="footer-nav">
        <a href="https://github.com/msbel5" target="_blank" rel="noopener">github</a>
        <a href="https://www.linkedin.com/in/msbel5" target="_blank" rel="noopener">linkedin</a>
        <a href="mailto:msbel5@gmail.com">email</a>
        <a href="/rss.xml">rss</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    padding-block: 4rem 3rem;
    border-top: 1px solid var(--border);
    background: var(--bg-base);
    font-size: 0.875rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr 0.8fr;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .footer-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--text-muted);
  }

  .footer-line {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .footer-line .dim {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    min-width: 5rem;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-end;
  }

  @media (max-width: 768px) {
    .footer-nav {
      align-items: flex-start;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1rem;
    }
  }

  .footer-nav a {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-muted);
    border-bottom: 1px solid transparent;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .footer-nav a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
</style>
