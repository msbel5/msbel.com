---
const { current = '' } = Astro.props;
const links = [
  { href: '/', label: 'home', key: 'home' },
  { href: '/projects', label: 'projects', key: 'projects' },
  { href: '/writing', label: 'writing', key: 'writing' },
  { href: '/about', label: 'about', key: 'about' },
];
---

<header class="header">
  <a href="/" class="brand" aria-label="msbel — home">
    <span class="brand-mark" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 64 64" class="kingfisher">
        <g fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="32" cy="14" r="5" fill="currentColor" stroke="none"></circle>
          <path d="M32 8 L32 2"></path>
          <path d="M32 19 L26 38 L32 50"></path>
          <path d="M32 19 L38 38 L32 50"></path>
          <path d="M32 50 L32 58"></path>
        </g>
      </svg>
    </span>
    <span class="brand-name">msbel</span>
  </a>
  <nav>
    {links.map((link) => (
      <a
        href={link.href}
        class:list={['nav-link', { active: current === link.key }]}
      >
        {link.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 2rem;
    backdrop-filter: blur(16px);
    background: var(--bg-overlay);
    border-bottom: 1px solid var(--border);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--fg-display);
    text-decoration: none;
    border-bottom: none;
    transition: color var(--duration-fast) var(--ease-out);
  }
  .brand:hover { color: var(--fg-display); }

  .brand-mark {
    display: inline-flex;
    color: var(--accent);
    transition: transform 350ms var(--ease-out);
  }

  .brand:hover .brand-mark { transform: translateY(2px); }

  .kingfisher {
    display: block;
    animation: twinkle 6s ease-in-out infinite;
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0.85; }
    50% { opacity: 1; }
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    letter-spacing: -0.01em;
    color: var(--fg-display);
  }

  nav {
    display: flex;
    gap: 1.5rem;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--fg-muted);
    text-decoration: none;
    text-transform: lowercase;
    transition: color var(--duration-fast) var(--ease-out);
    position: relative;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--fg-display);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--accent);
  }

  @media (max-width: 640px) {
    .header { padding: 1rem 1.25rem; }
    nav { gap: 1rem; }
    .nav-link { font-size: 0.75rem; }
  }
</style>
