---
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'msbel — Engineer & Builder',
  description = 'msbel — senior test automation engineer in Istanbul. Building Alcyone (a self-hosted multi-agent AI on a Raspberry Pi 5), Thalamus (an OpenClaw community plugin on ClawHub and npm), a 9-layer testnet trading bot, an AI QA agent, and a hand-crafted RPG in Unity.',
  image = '/og-image.svg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Person JSON-LD only on homepage
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Muhammet Sıddık Bel',
  alternateName: ['M.S. Bel', 'msbel', 'msbel5'],
  givenName: 'Muhammet Sıddık',
  familyName: 'Bel',
  url: 'https://msbel.com',
  image: 'https://msbel.com/og-image.svg',
  jobTitle: 'Senior Test Automation Engineer',
  description:
    'Senior test automation engineer and AI agent builder based in Istanbul. Mechanical engineer by training, software engineer by obsession. Builds Alcyone (a self-hosted multi-agent AI on a Raspberry Pi 5), Thalamus (an OpenClaw community plugin), a 9-layer testnet trading bot, an AI QA agent, and a hand-crafted RPG in Unity.',
  knowsAbout: [
    'Test automation', 'AI agents', 'Machine learning',
    'Selenium', 'Appium', 'Gauge framework', 'PyTorch',
    'Multi-agent systems', 'OpenClaw', 'AutoGen', 'Claude API',
    'Vector retrieval', 'FAISS', 'Qwen3',
    'Trading bots', 'Mechanical engineering', 'Mechatronics',
    'LabVIEW', 'Arduino', 'Raspberry Pi',
  ],
  alumniOf: [
    {
      '@type': 'CollegeOrUniversity',
      name: 'Marmara University',
      department: 'Mechatronics Engineering',
    },
    {
      '@type': 'CollegeOrUniversity',
      name: 'Istanbul University',
      department: 'Mechanical Engineering',
    },
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Istanbul',
    addressCountry: 'TR',
  },
  sameAs: [
    'https://github.com/msbel5',
    'https://www.linkedin.com/in/msbel5',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'msbel',
  alternateName: ['msbel.com', 'M.S. Bel'],
  url: 'https://msbel.com',
  description: 'Personal site of msbel — engineer and builder, Istanbul.',
  author: { '@type': 'Person', name: 'Muhammet Sıddık Bel' },
  inLanguage: 'en-US',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Muhammet Sıddık Bel" />
    <meta name="keywords" content="msbel, msbel5, M.S. Bel, test automation engineer, AI agent builder, Istanbul, OpenClaw, Thalamus, Alcyone, Raspberry Pi 5, Selenium, Gauge, PyTorch, multi-agent systems, vector retrieval, e-Residency Estonia" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta property="og:site_name" content="msbel.com" />
    <meta property="og:locale" content="en_US" />
    <meta property="profile:first_name" content="Muhammet Sıddık" />
    <meta property="profile:last_name" content="Bel" />
    <meta property="profile:username" content="msbel5" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:creator" content="@msbel5" />

    <!-- Structured data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    />
    {isHome && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(personSchema)}
      />
    )}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts: msbel Hybrid (self-host) + Geist Sans + Geist Mono + Fraunces (fallback) via global.css -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="/fonts/msbel-hybrid.otf" as="font" type="font/otf" crossorigin />

    <!-- Theme color -->
    <meta name="theme-color" content="#0d0e10" />

    <!-- View Transitions API -->
    <meta name="view-transition" content="same-origin" />
  </head>
  <body>
    <slot />
    <Footer />
  </body>
</html>
