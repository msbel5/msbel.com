---
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'M.S. Bel - QA Engineer & Automation Builder',
  description = 'Portfolio of M.S. Bel, a QA Engineer in Istanbul building reliable test automation, agent workflows, Pi-hosted tooling, trading experiments, and hand-built RPG systems.',
  image = '/og-image.svg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Person JSON-LD only on homepage
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Muhammet Sıddık Bel',
  alternateName: ['M.S. Bel', 'msbel', 'msbel5'],
  givenName: 'Muhammet Sıddık',
  familyName: 'Bel',
  url: 'https://msbel.com',
  image: 'https://msbel.com/og-image.svg',
  jobTitle: 'QA Engineer',
  description:
    'QA Engineer and automation builder based in Istanbul. Work spans test automation, agent workflows, Pi-hosted tooling, trading experiments, and hand-built RPG systems.',
  knowsAbout: [
    'Test automation', 'AI agents', 'Machine learning',
    'Selenium', 'Appium', 'Gauge framework', 'PyTorch',
    'Multi-agent systems', 'AutoGen', 'Claude API',
    'Trading bots', 'Reinforcement learning',
    'Mechanical engineering', 'Mechatronics',
    'LabVIEW', 'Arduino', 'Raspberry Pi',
  ],
  alumniOf: [
    {
      '@type': 'CollegeOrUniversity',
      name: 'Marmara University',
      department: 'Mechatronics Engineering',
    },
    {
      '@type': 'CollegeOrUniversity',
      name: 'Istanbul University',
      department: 'Mechanical Engineering',
    },
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Istanbul',
    addressCountry: 'TR',
  },
  sameAs: [
    'https://github.com/msbel5',
    'https://www.linkedin.com/in/msbel5',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'M.S. Bel',
  alternateName: ['msbel', 'msbel.com', 'msbel5'],
  url: 'https://msbel.com',
  description: 'Portfolio and build log for M.S. Bel.',
  author: { '@type': 'Person', name: 'Muhammet Sıddık Bel' },
  inLanguage: 'en-US',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Muhammet Sıddık Bel" />
    <meta name="keywords" content="M.S. Bel, msbel, msbel5, Muhammet Sıddık Bel, QA Engineer, Senior Test Automation Engineer, test automation, AI agent builder, Istanbul, OpenClaw, Thalamus, Alcyone, Selenium, Gauge, PyTorch, Raspberry Pi" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta property="og:site_name" content="msbel.com" />
    <meta property="og:locale" content="en_US" />
    <meta property="profile:first_name" content="Muhammet Sıddık" />
    <meta property="profile:last_name" content="Bel" />
    <meta property="profile:username" content="msbel5" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:creator" content="@msbel5" />

    <!-- Structured data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    />
    {isHome && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(personSchema)}
      />
    )}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts: Fraunces (display) + Geist Sans + Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,300..700,30..100&family=Geist:wght@300..700&family=Geist+Mono:wght@400..600&display=swap"
      rel="stylesheet"
    />

    <!-- Theme color -->
    <meta name="theme-color" content="#0d0e10" />

    <!-- View Transitions API -->
    <meta name="view-transition" content="same-origin" />
  </head>
  <body>
    <slot />
    <Footer />
  </body>
</html>
